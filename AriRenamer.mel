		-af $AriRenamer_UI_targetNameTextField "top"   0
		-af $AriRenamer_UI_targetNameTextField "bottom" 0
		$ringFrome;
		setParent..;
		string $leftButtonG = `columnLayout -adj true`;
		$AriRenameInputField[2]   = `textField -w 60 -h 24 -cc "AriRenamer_GetNode(0)"`;
		rowLayout -nc 7 ;
			columnLayout -adj true;
				button  -w 60 -h 25 -label $label_Hierarchy -c "SelectHierarchy; AriRenamer_GetNode(0);";
				$AriRenamerButton[1]    = `button  -w 60 -h 50 -label "Get"      -ann "選択したノードを取得リスト一覧に追加" -bgc 0 0.8 0.5 -c "AriRenamer_GetNode(0)"`;
				$AriRenamerButton[2]    = `button  -w 60 -h 20 -label "File"      -ann ""  -vis false -bgc 0.9 0.9 0.9 -c "AriRenamer_GetDataFile()"`;
				$AriRenamerButton[3]    = `button  -w 60 -h 20 -label "Directory" -ann ""  -vis false -bgc 0.8 0.8 0.5 -c "AriRenamer_GetDataFile()"`;
			setParent..;
			columnLayout -adj true;
				string $pmButtonForm = `formLayout`;
				string $pButton = `button  -h 22 -l "+"   -c "AriRenamer_GetNode(1)"    -ann "取得リストに追加します"`;
				string $mButton = `button  -h 22 -l "-"   -c "AriRenamer_ListExclude()" -ann "取得リストから削除します"`;
				setParent..;
				formLayout -e
				-af $pButton "left" 0
				-ap $pButton "right" 0 50
				-af $mButton "right" 0
				-ac $mButton "left"  0 $pButton
				$pmButtonForm;
				$AriRename_UI_ShapeCB = `checkBox   -w 60 -h 25 -l "Shape" -v 0 -ann "shapeノードも読み込みます"`;
				button -w 60 -h 25 -l "Type"  -ann "";
				$AriRenamer_UI_TypePop = `popupMenu -button 1 `;
			setParent..;
		setParent..;
		setParent..;
		string $label_DelNum = "数字削除";
		string $label_UnifNum = "数字桁数統一";
		if($jpTrue == false){
			$label_DelNum  = "Delete numbers";
			$label_UnifNum = "Unified number of digits";
		}
		string $centerButtonG=`columnLayout -adj true -bgc 0.2 0.2 0.2`;
			string $formB;
			string $button[];
			string $rightRow =`rowLayout -nc 2 -adj 1`;
			string $deleteForm = `formLayout `;
				string $buttonDel = `button -w 30 -h 20 -label "[...] Del >" -ann "すべての行で カーソルより前にある文字数を保管し 後ろの文字を消去" -c "AriRenamer_DelBs(0)"`;
				string $buttonBs  = `button -w 30 -h 20 -label "< BS [...]"  -ann "すべての行で カーソルより後ろにある文字数を保管し 前の文字を消去"  -c "AriRenamer_DelBs(1)"`;
			setParent..;
				formLayout -e
				-af $buttonDel "left"  0             -ap $buttonDel "right" 0 50
				-ac $buttonBs  "left"  0 $buttonDel  -af $buttonBs  "right" 0
			$deleteForm;
			button -w 60 -h 24 -label "Undo" -c "AriRenamer_Undo()";
			setParent..;
			global string $AriRenamer_UI_InsertMenu;
			$AriRenamer_UI_InsertMenu = `columnLayout -adj true `;
			$formB = `formLayout`;
				$AriRenameInputField[1] = `textField `;
				$button[0]=`button -w 50 -h 20 -l $label_Insert  -ann "入力した文字をカーソルの位置に挿入" -c "AriRenamer_insertion()"`;
				$button[1]=`button -w 50 -h 20 -l $label_Rewrite -ann "入力した文字をカーソルの位置に挿入" -c "AriRenamer_allChange()"`;
			setParent..;
			formLayout -e
				-af $button[1] "right" 0
				-ac $button[0] "right" 0 $button[1]
				-af $AriRenameInputField[1] "left" 0
				-ac $AriRenameInputField[1] "right" 0 $button[0]
			$formB;
			$formB = `formLayout`;
			radioCollection;
				$AriRename_radio[0] = `radioButton -h 20 -label $label_CoStart -ann "前から数えたカーソルの位置に挿入\nCount from the front and insert at the cursor position"  -select`;
				$AriRename_radio[1] = `radioButton -h 20 -label $label_CoEnd   -ann "後ろから数えたカーソルの位置に挿入\nInsert at the cursor position counting from the back" `;
				string $numberButton = `button -w 50 -h 20 -l "012"`;
				popupMenu -button 1 ;
				menuItem -l "Apply" -c "AriRenamer_numbering_GO(0)" -ann "";
				menuItem -divider true;
				menuItem -l "1"     -c "AriRenamer_numbering_GO(1)" -ann "";
				menuItem -l "01"    -c "AriRenamer_numbering_GO(2)" -ann "";
				menuItem -l "001"   -c "AriRenamer_numbering_GO(3)" -ann "";
				menuItem -l "0001"  -c "AriRenamer_numbering_GO(4)" -ann "";
				menuItem -l "00001" -c "AriRenamer_numbering_GO(5)" -ann "";
				menuItem -l "a" -c "AriRenamer_numbering_GO(100)" -ann "";
				menuItem -l "A" -c "AriRenamer_numbering_GO(101)" -ann "";
				menuItem -divider true;
				menuItem -l $label_DelNum  -c "AriRenamer_Condition_BackNumberDel()";
				menuItem -l $label_UnifNum -subMenu true -c "AriRenamer_Condition_NumberDouble_Window()";
					menuItem -label "1" -c "AriRenamer_Condition_NumberDouble(1)";
					menuItem -label "2" -c "AriRenamer_Condition_NumberDouble(2)";
					menuItem -label "3" -c "AriRenamer_Condition_NumberDouble(3)";
					menuItem -label "4" -c "AriRenamer_Condition_NumberDouble(4)";
					menuItem -label "5" -c "AriRenamer_Condition_NumberDouble(5)";
					menuItem -label "6" -c "AriRenamer_Condition_NumberDouble(6)";
					menuItem -label "7" -c "AriRenamer_Condition_NumberDouble(7)";
				setParent -menu ..;
				menuItem -divider true;
				menuItem -i "gear.png" -l "Option"       -c "AriRenamer_Numbering_Window()";
				setParent..;
			formLayout -e
				-af $AriRename_radio[0] "left"  0
				-ac $AriRename_radio[1] "left"  0 $AriRename_radio[0]
				-af $numberButton "right" 0
			$formB;
			string $function_label[];
			string $function_command[];
			string $function_annotation[];
			$function_label[0] = "機能";
			$function_label[1] = ": の前方消去";
			$function_label[2] = "fileノードをテクスチャ名に";
			$function_label[3] = "fileノードをテクスチャ名に(拡張子付)";
			$function_label[4] = "数字削除";
			$function_label[5] = "数字桁数統一";
			$function_label[6] = "shapeノードを標準名に(親+Shape名) ～Maya2018";
			$function_label[7] = "親グループ名に";
			$function_label[8] = "shapeノードを標準名に(親+Shape名) Maya2019～";
			int $functionJPTrue = $jpTrue;
			if($functionJPTrue == false){
				$function_label[0] = "Function";
				$function_label[1] = "Remove the front of : ";
				$function_label[2] = "File node to texture name";
				$function_label[3] = "File node to texture name (extension)";
				$function_label[4] = "Delete numbers";
				$function_label[5] = "Unified number of digits";
				$function_label[6] = "Shape Node to \"Parent+Shape\" (-Maya2018)";
				$function_label[7] = "To parent group name";
				$function_label[8] = "Shape Node to \"Parent+Shape\" (Maya2019-)";
			}
			$function_command[0] = "";
			$function_command[1] = "AriRenamer_Condition_GO(1);";
			$function_command[2] = "AriRenamer_Condition_FileName(0);";
			$function_command[3] = "AriRenamer_Condition_FileName(1);";
			$function_command[4] = "AriRenamer_Condition_BackNumberDel();";
			$function_command[5] = "AriRenamer_Condition_NumberDouble_Window();";
			$function_command[6] = "AriRenamer_Condition_ShapeName(1);";
			$function_command[7] = "AriRenamer_Condition_GroupName();";
			$function_command[8] = "AriRenamer_Condition_ShapeName(0);";
			$function_annotation[0] = "";
			$function_annotation[1] = " : より前にある文字を消去します。\nErases the characters before A.";
			$function_annotation[2] = "fileノードであればテクスチャ名に変更します。";
			$function_annotation[3] = "拡張子も付けます。( . は使用不可なので _ に)";
			$function_annotation[4] = "末尾が数字の場合、数字を消します。";
			$function_annotation[5] = "末尾が数字の場合、桁数を統一します。";
			$function_annotation[6] = "親トランスフォーム名に従ってpCube001→pCube00Shape1の形にします。";
			$function_annotation[7] = "親グループ名の名前に統一します。";
			$function_annotation[8] = "";
			$formB=`formLayout`;
				$button[0] = `button -w 50 -label $lable_Replace -ann "置換メニューを表示" -c "AriRenamer_Replace_Menu(1)"`;
				$button[3] = `button -w 50 -label $lable_Function -ann "" `;
					popupMenu -button 1 ;
					menuItem -l $function_label[7] -c $function_command[7] -ann $function_annotation[7];
					menuItem -l $function_label[1] -c $function_command[1] -ann $function_annotation[1];
					menuItem -divider true;
					menuItem -l $function_label[2] -c $function_command[2] -ann $function_annotation[2];
					menuItem -l $function_label[3] -c $function_command[3] -ann $function_annotation[3];
					menuItem -divider true;
					menuItem -l $function_label[4] -c $function_command[4] -ann $function_annotation[4];
					menuItem -l $function_label[5] -c $function_command[5] -ann $function_annotation[5];
					menuItem -divider true;
					menuItem -l $function_label[6] -c $function_command[6] -ann $function_annotation[6];
					menuItem -l $function_label[8] -c $function_command[8] -ann $function_annotation[8];
			setParent..;
			formLayout -e
			-af $button[0] "left"  0             -ap $button[0] "right" 0 50
			-ac $button[3] "left"  0 $button[0]  -ap $button[3] "right" 0 100
			$formB;
			setParent..;
			global string $AriRenamer_UI_ReplaceMenu;
			$AriRenamer_UI_ReplaceMenu = `columnLayout -vis false -adj true -bgc 0.3 0.3 0.3 `;
			global string $AriRenamer_UI_ReTextField[3];
			rowLayout -nc 2 -adj 2;
			button -w 60 -h 20 -l $lable_Before -c "AriRenamer_Replace_Get(0)";
			$AriRenamer_UI_ReTextField[0] = `textField -w 100 `;
			setParent..;
			rowLayout -nc 2 -adj 2;
			button -w 60 -h 20 -l $lable_After -c "AriRenamer_Replace_Get(1)";
			$AriRenamer_UI_ReTextField[1] = `textField -w 100 `;
			setParent..;
			rowLayout -nc 2 -adj 2;
			button -w 100 -l $lable_ReClose -bgc 0 0 0 -c "AriRenamer_Replace_Menu(0)";
			button -w 100 -l $lable_ReplaceGO -bgc 0 0.5 1 -c "AriRenamer_Replace_GO()";
			setParent..;
			setParent..;
		setParent..;
		string $rightButtonG=`rowLayout -nc 2`;
		columnLayout;
		$AriRenamer_OMenu[0] = `optionMenu -w 60 -h 24 -label "" -changeCommand "AriRenamer_getModeChange()"`;
				menuItem -label "Node";
				menuItem -label "Path";
				menuItem -label "Texture";
			separator -h 3 -w 60 -st "in";
			rowLayout -nc 2;
			$AriRename_UI_resultCB = `checkBox -v $resultCheckBox -h 24 -l "" -ann "リネーム結果ウィンドウを表示します"`;
			button -w 40 -h 20 -l $label_Result -c "AriRenamer_OpenResultWindow()";
			setParent..;
			$AriRenamerButton[0] = `button -w 60 -h 50 -bgc 1 1 0.2 -label "Rename" -c "AriRenamer_RenameGO()" -ann "左フィールド名前のノードを右フィールドの名前にリネーム" `;
		setParent..;
		columnLayout;
				$AriRename_modeValue = `intField -vis false -v 0 -w 40 `;
			setParent..;
		setParent..;
		setParent..;
	setParent..;
	formLayout -edit
		-af $leftButtonG "bottom" 0
		-af $leftButtonG "left"   0
		-af $rightButtonG "bottom"  0
		-af $rightButtonG "right"   0
		-af $centerButtonG "bottom" 0
		-ac $centerButtonG "right"  0 $rightButtonG 
		-ac $centerButtonG "left"   0 $leftButtonG
		-ac $pageView "bottom" 0 $rightButtonG
		-af $pageView "left"   0
		-af $pageView "right"  0
		-af $AriRenamerPaneLayout "top"   0
		-af $AriRenamerPaneLayout "left"  0
		-af $AriRenamerPaneLayout "right" 0
		-ac $AriRenamerPaneLayout "bottom" 0 $pageView
		$form;
	showWindow;
	AriRenamer_GetNode(0);
	scriptJob -p "AriRenamer" -event "SelectionChanged" "AriRenamer_ObjSelect()";
}
