	string $label_Hierarchy = "Hierarchy";
	string $label_Result    = "Result";   
	string $label_Insert    = "Insert";   
	string $label_Rewrite   = "Rewrite";
	string $label_CoStart   = "Start Count";
	string $label_CoEnd     = "End Count";
	string $lable_Replace   = "Replace";
	string $lable_ReplaceGO = "ReplaceGO";
	string $lable_Function  = "Function";
	string $lable_Before    = "Before";
	string $lable_After     = "After";
	string $lable_ReClose   = "Replace Close";
	if($jpTrue){
		$label_Hierarchy = "階層選択";
		$label_Result    = "結果";
		$label_Insert    = "挿入";
		$label_Rewrite   = "書換";
		$label_CoStart   = "前文字数一致";
		$label_CoEnd     = "後文字数一致";
		$lable_Replace   = "置換";
		$lable_ReplaceGO = "置換実行";
		$lable_Function  = "機能";
		$lable_Before    = "置換前";
		$lable_After     = "置換後";
