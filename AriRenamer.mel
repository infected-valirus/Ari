		-ac $AriRenamer_UI_baseNameTextField "bottom" 0 $leftUnder
		$rightForm;
		string $ringFrome =`formLayout`;
		$AriRenamer_UI_targetNameTextField = `scrollField   `;
		popupMenu -button 3;
		menuItem -l "Select" -c "AriRenamer_RightSelect()";	
		setParent..;
		formLayout -e
		-af $AriRenamer_UI_targetNameTextField "left"  0
