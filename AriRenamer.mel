		$AriRenamer_UI_baseNameTreeView   = `treeView     -enk true -nb 1 
												-itemDblClickCommand ""
												-scc "AriRenamer_LeftSelect(1)"  -vis false -adr false`;
		string $leftUnder = `rowLayout -nc 3 -vis false`;
		$AriRenamer_UI_selectNumL = `intField  -ed false -w 40`;
